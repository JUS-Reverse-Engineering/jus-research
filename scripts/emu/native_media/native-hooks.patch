@@ -4,6 +4,75 @@
 std::vector<luaL_Reg> nativeCaptureFunctions;
 LuaLibrary nativeCaptureLibrary("capture", &nativeCaptureFunctions);
 
+static QVariantList IntegerList(lua_State* L, int index, const char* name, size_t limit)
+{
+    QVariantList out;
+    lua_getfield(L, index, name);
+    if (!lua_isnil(L, -1))
+    {
+        luaL_checktype(L, -1, LUA_TTABLE);
+        auto count = lua_rawlen(L, -1);
+        if (count > limit) luaL_error(L, "too many %s", name);
+        for (size_t i = 1; i <= count; ++i)
+        {
+            lua_geti(L, -1, i); auto value = luaL_checkinteger(L, -1); lua_pop(L, 1);
+            if (value < INT32_MIN || value > UINT32_MAX) luaL_error(L, "invalid %s", name);
+            out.append(value < 0 ? QVariant(int(value)) : QVariant(uint(value)));
+        }
+    }
+    lua_pop(L, 1);
+    return out;
+}
+
+// Optional sixth argument: {calls={pc,...}, lists={{address=, offsets={}, next=, limit=,
+// fields={{path={...}, length=, optional=}}}}}. Bounds are checked by NativeHooks::validate.
+static void ParseHooks(lua_State* L, int index, QVariantMap& config)
+{
+    luaL_checktype(L, index, LUA_TTABLE);
+    config["calls"] = IntegerList(L, index, "calls", 64);
+    QVariantList lists;
+    lua_getfield(L, index, "lists");
+    if (!lua_isnil(L, -1))
+    {
+        luaL_checktype(L, -1, LUA_TTABLE);
+        auto count = lua_rawlen(L, -1);
+        if (count > 4) luaL_error(L, "too many lists");
+        int listsIndex = lua_gettop(L);
+        for (size_t i = 1; i <= count; ++i)
+        {
+            lua_geti(L, listsIndex, i); luaL_checktype(L, -1, LUA_TTABLE);
+            int item = lua_gettop(L);
+            QVariantMap list;
+            lua_getfield(L, item, "address"); list["address"] = uint(luaL_checkinteger(L, -1)); lua_pop(L, 1);
+            lua_getfield(L, item, "next"); list["next"] = int(luaL_checkinteger(L, -1)); lua_pop(L, 1);
+            lua_getfield(L, item, "limit"); list["limit"] = uint(luaL_checkinteger(L, -1)); lua_pop(L, 1);
+            list["offsets"] = IntegerList(L, item, "offsets", 8);
+            QVariantList fields;
+            lua_getfield(L, item, "fields"); luaL_checktype(L, -1, LUA_TTABLE);
+            int fieldsIndex = lua_gettop(L);
+            auto fieldCount = lua_rawlen(L, fieldsIndex);
+            if (fieldCount > 16) luaL_error(L, "too many list fields");
+            for (size_t j = 1; j <= fieldCount; ++j)
+            {
+                lua_geti(L, fieldsIndex, j); luaL_checktype(L, -1, LUA_TTABLE);
+                int f = lua_gettop(L);
+                QVariantMap field;
+                field["path"] = IntegerList(L, f, "path", 9);
+                lua_getfield(L, f, "length"); field["length"] = uint(luaL_checkinteger(L, -1)); lua_pop(L, 1);
+                lua_getfield(L, f, "optional");
+                if (!lua_isnil(L, -1) && !lua_isboolean(L, -1)) luaL_error(L, "optional must be boolean");
+                field["optional"] = bool(lua_toboolean(L, -1)); lua_pop(L, 2);
+                fields.append(field);
+            }
+            lua_pop(L, 2);
+            list["fields"] = fields;
+            lists.append(list);
+        }
+    }
+    lua_pop(L, 1);
+    config["lists"] = lists;
+}
