+// Native recorder GPU-media observation: packs the registers the native stream versions
+// and hands the consumed bytes to GPU.Native*Observer. Read-only.
+static void PutLE(u8* out, u32 value, int bytes) { for (int i = 0; i < bytes; i++) out[i] = u8(value >> (8 * i)); }
+
+void SoftRenderer2D::NotifySprites(u32 line)
+{
+    if (!GPU.NativeSpriteObserver) [[likely]] return;
+    u8 regs[12] = {};
+    PutLE(regs, GPU2D.DispCnt, 4);
+    regs[4] = GPU2D.OBJEnable; regs[5] = GPU2D.Enabled;
+    // mosaic latch as a distance back from the drawn line: constant while OBJMosaicSize[1] is 0, so it does not split spans
+    PutLE(regs + 8, (line - GPU2D.OBJMosaicLine) & 0xFF, 4);
+    u8* objvram; u32 objvrammask;
+    GPU2D.GetOBJVRAM(objvram, objvrammask);
+    GPU.NativeSpriteObserver(GPU2D.Num, line, &GPU.OAM[GPU2D.Num ? 0x400 : 0], objvram, objvrammask + 1, regs);
+}
+
+void SoftRenderer2D::NotifyCompose(u32 line)
+{
+    if (!GPU.NativeComposeObserver) [[likely]] return;
+    u8 regs[36] = {};
+    PutLE(regs, GPU2D.DispCnt, 4);
+    regs[4] = GPU2D.LayerEnable; regs[5] = GPU2D.ForcedBlank; regs[6] = GPU2D.Enabled; regs[7] = GPU.ScreenSwap;
+    PutLE(regs + 8, GPU2D.BlendCnt, 2); PutLE(regs + 10, GPU2D.BlendAlpha, 2);
+    regs[12] = GPU2D.EVA; regs[13] = GPU2D.EVB; regs[14] = GPU2D.EVY; regs[15] = GPU2D.Win0Active;
+    for (int i = 0; i < 4; i++) { regs[16 + i] = GPU2D.Win0Coords[i]; regs[20 + i] = GPU2D.Win1Coords[i]; regs[24 + i] = GPU2D.WinCnt[i]; }
+    regs[28] = GPU2D.Win1Active; regs[29] = GPU2D.OBJMosaicSize[0]; regs[30] = GPU2D.OBJMosaicSize[1];
+    PutLE(regs + 32, GPU2D.Num ? GPU.MasterBrightnessB : GPU.MasterBrightnessA, 2);
+    GPU.NativeComposeObserver(GPU2D.Num, line, &GPU.Palette[GPU2D.Num ? 0x600 : 0x200],
+                              reinterpret_cast<const u8*>(GPU2D.GetOBJExtPal()), regs);
+}
