diff --git a/src/ARMJIT.cpp b/src/ARMJIT.cpp
index 4c46eea4..27e9ecc7 100644
--- a/src/ARMJIT.cpp
+++ b/src/ARMJIT.cpp
@@ -240,6 +240,10 @@ void ARMJIT::Reset() noexcept
 {
     JitEnableWrite();
     ResetBlockCache();
+    // Leave the calling thread able to execute JIT pages again. On Apple
+    // Silicon the write/execute toggle is per-thread, and if Reset() runs on
+    // the UI thread any later JIT'd code there (e.g. Qt's PCRE2) would fault.
+    JitEnableExecute();
 
     Memory.Reset();
 }
