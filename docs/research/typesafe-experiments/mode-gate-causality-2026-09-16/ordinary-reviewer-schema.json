{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "unsupported_step", "preserved_observations", "next_check"],
  "properties": {
    "verdict": {"type": "string", "enum": ["supported", "contradicted", "underdetermined", "invalid"]},
    "unsupported_step": {"type": "string"},
    "preserved_observations": {"type": "array", "items": {"type": "string"}},
    "next_check": {"type": "string"}
  }
}
